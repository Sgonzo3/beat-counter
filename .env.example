# From https://dashboard.linqapp.com/sandbox-signup
LINQ_API_KEY=your_bearer_token_here
LINQ_PHONE_NUMBER=+1XXXXXXXXXX

# Filled automatically by `npm start` when the webhook subscription is created.
# LINQ_WEBHOOK_SECRET=whsec_...
# PUBLIC_WEBHOOK_URL=https://xxxx.trycloudflare.com

PORT=3000

# Optional: Netscape cookies file so yt-dlp can fetch YouTube / YT Music
# when the host IP is bot-challenged.
# YTDLP_COOKIES=/absolute/path/to/cookies.txt
